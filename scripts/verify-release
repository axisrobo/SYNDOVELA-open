#!/bin/sh
# verify-release — verify a SYNDOVELA Open release directory.
#
# Usage:  verify-release <release-dir>
#   e.g.  ./scripts/verify-release releases/v1.0.0/windows-amd64
#
# Checks, in order:
#   1. every binary named in SHA256SUMS exists and its SHA-256 matches;
#   2. if SHA256SUMS.asc is a real OpenPGP signature, verifies it with gpg
#      (a "placeholder" signature is reported as a warning, not an error).
#
# Exits non-zero if any checksum check fails. Exit code 2 means the
# signature check was skipped or degraded.

set -u

RELEASE_DIR=${1:-}
if [ -z "$RELEASE_DIR" ]; then
  echo "usage: $0 <release-dir>" >&2
  exit 2
fi
if [ ! -f "$RELEASE_DIR/SHA256SUMS" ]; then
  echo "error: no SHA256SUMS in $RELEASE_DIR" >&2
  exit 2
fi

fail=0

# 1. Checksum verification.
while read -r digest file; do
  [ -n "$digest" ] || continue
  digest=$(printf '%s' "$digest" | tr -d '\r\357\273\277')
  file=$(printf '%s' "$file" | tr -d '\r')
  path="$RELEASE_DIR/$file"
  if [ ! -f "$path" ]; then
    echo "FAIL  missing: $file" >&2
    fail=1
    continue
  fi
  actual=$(sha256sum "$path" | awk '{print $1}')
  if [ "$actual" != "$digest" ]; then
    echo "FAIL  digest mismatch: $file (got $actual)" >&2
    fail=1
  else
    echo "ok    $file"
  fi
done < "$RELEASE_DIR/SHA256SUMS"

# 2. Signature verification (real OpenPGP only).
if [ -f "$RELEASE_DIR/SHA256SUMS.asc" ]; then
  if grep -q 'placeholder' "$RELEASE_DIR/SHA256SUMS.asc"; then
    echo "warn  SHA256SUMS.asc is a placeholder; checksums above are authoritative" >&2
    exit $([ "$fail" -eq 0 ] && echo 2 || echo 1)
  elif command -v gpg >/dev/null 2>&1; then
    if gpg --verify "$RELEASE_DIR/SHA256SUMS.asc" "$RELEASE_DIR/SHA256SUMS" 2>/dev/null; then
      echo "ok    OpenPGP signature verified"
    else
      echo "FAIL  OpenPGP signature did not verify" >&2
      fail=1
    fi
  else
    echo "warn  gpg not installed; skipped signature verification" >&2
    exit $([ "$fail" -eq 0 ] && echo 2 || echo 1)
  fi
else
  echo "warn  no SHA256SUMS.asc present" >&2
fi

exit $([ "$fail" -eq 0 ] && echo 0 || echo 1)
